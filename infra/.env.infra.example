# Copie para infra/.env (nunca versionar). Gere segredos longos e aleatórios.
N8N_VERSION=            # fixe uma versão estável (ex.: a última 1.x ou 2.x testada) — nunca "latest"
N8N_DOMINIO=automacao.suaagencia.com.br
N8N_ENCRYPTION_KEY=     # guarde também fora do servidor: sem ela, as credenciais do n8n não voltam do backup
POSTGRES_USER=n8n
POSTGRES_PASSWORD=
TRILHA_API_TOKEN=
TRILHA_SIMULAR=1
TRILHA_CLIENTES_DIR=/srv/trilha-clientes/clientes
KOMMO_WEBHOOK_TOKEN=
SLACK_WEBHOOK_URL=
META_ACCESS_TOKEN=
META_GRAPH_VERSION=v23.0
META_TEST_EVENT_CODE=
