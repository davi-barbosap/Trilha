# Copie para infra/kommo-tokens.env (nunca versionar). Um par por cliente; o sufixo é o cliente.id do perfil.yaml
# (= nome da pasta) em maiúsculas, com "-" trocado por "_". Registre a validade de cada token no ClickUp.
#
# KOMMO_TOKEN_<CLIENTE>          token da API do Kommo do cliente (leitura de leads)
# KOMMO_WEBHOOK_TOKEN_<CLIENTE>  segredo próprio do webhook desse cliente — nunca reutilizar entre clientes,
#                                porque o admin do Kommo de cada cliente enxerga a URL do webhook
KOMMO_TOKEN_IMOB_A=
KOMMO_WEBHOOK_TOKEN_IMOB_A=
