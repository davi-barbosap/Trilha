# Copie para .env e preencha. Nunca versione o .env.

# Uso local/CLI. No servidor, use infra/.env.infra.example e infra/kommo-tokens.env.example.

# Kommo — um token por cliente: KOMMO_TOKEN_<CLIENTE_ID em maiúsculas>
KOMMO_TOKEN_EXEMPLO=
KOMMO_WEBHOOK_TOKEN=

# Meta — API de Conversões
META_ACCESS_TOKEN=
META_GRAPH_VERSION=v23.0
META_TEST_EVENT_CODE=

# Google Ads API
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=

# ClickUp
CLICKUP_TOKEN=
CLICKUP_WEBHOOK_SECRET=

# Slack (urgências, freio, falhas, leitura diária — nunca para o cliente)
SLACK_WEBHOOK_URL=

# Trilha
TRILHA_API_TOKEN=
TRILHA_API_URL=http://localhost:8080
TRILHA_SIMULAR=1                 # 0 só depois do teste com META_TEST_EVENT_CODE
TRILHA_CLIENTES_DIR=../trilha-clientes/clientes
TRILHA_LOG_DIR=logs
